DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=INFO

# Required in production (DJANGO_DEBUG=false). Redis-first Open-Meteo + plan cache.
REDIS_URL=

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# Optional: commercial key + https://customer-api.open-meteo.com/v1/forecast to avoid free-tier 429s.
OPEN_METEO_API_KEY=
VALHALLA_URL=https://valhalla1.openstreetmap.de/route
HEATMAP_MAX_CELLS=600

VITE_API_URL=
